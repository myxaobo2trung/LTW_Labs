    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Danh sach san pham";
    var productlist = ViewData["products"] as List<MDDControler.Models.DucDuyProduct>;
    var stt = 0;
}
<h1>@ViewData["Title"]</h1>
<hr />
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Quantity</th>
            <th>Price</th>
            <th>Money</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach  (var item in productlist)
        {
            var finalPrice = item.quantity * item.price;
            stt++;
            <tr>
                <td>@stt</td>
                <td>@item.productId</td>
                <td>@item.productName</td>
                <td>@item.quantity</td>
                <td>@item.price</td>
                <td>@finalPrice</td>
                <td>
                    <a href="" class="btn btn-primary">Xem</a>
                    <a href="" class="btn btn-info">Sua</a>
                    <a href="" class="btn btn-danger">Xoa</a>
                </td>
            </tr>
        }
    </tbody>
</table>

