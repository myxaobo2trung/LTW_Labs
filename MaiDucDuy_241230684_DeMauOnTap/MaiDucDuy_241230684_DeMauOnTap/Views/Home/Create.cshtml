@model MaiDucDuy_241230684_DeMauOnTap.Models.Sach

<div class="section-head">
    <h3>HỌ TÊN SINH VIÊN - THÊM SÁCH MỚI</h3>
</div>

<div style="background:#fff; padding:24px; border-radius:8px; max-width:450px; box-shadow:0 1px 4px rgba(0,0,0,.1);">
    <form asp-action="Create" method="post">
        <div style="margin-bottom:14px;">
            <label asp-for="MaTl" style="display:block; margin-bottom:5px; font-weight:500;">MaTL</label>
            <select asp-for="MaTl" asp-items="ViewBag.MaTl" style="width:100%; padding:8px; border:1px solid #c5d3d8; border-radius:4px;"></select>
            <span asp-validation-for="MaTl" style="color:red; font-size:13px;"></span>
        </div>

        <div style="margin-bottom:14px;">
            <label asp-for="TenSach" style="display:block; margin-bottom:5px; font-weight:500;">TenSach</label>
            <input asp-for="TenSach" style="width:100%; padding:8px; border:1px solid #c5d3d8; border-radius:4px;" />
            <span asp-validation-for="TenSach" style="color:red; font-size:13px;"></span>
        </div>

        <div style="margin-bottom:14px;">
            <label asp-for="Gia" style="display:block; margin-bottom:5px; font-weight:500;">Gia</label>
            <input asp-for="Gia" style="width:100%; padding:8px; border:1px solid #c5d3d8; border-radius:4px;" />
            <span asp-validation-for="Gia" style="color:red; font-size:13px;"></span>
        </div>

        <div style="margin-bottom:16px;">
            <label asp-for="Anh" style="display:block; margin-bottom:5px; font-weight:500;">Anh</label>
            <input asp-for="Anh" placeholder="Ví dụ: Img_1.jpg" style="width:100%; padding:8px; border:1px solid #c5d3d8; border-radius:4px;" />
            <span asp-validation-for="Anh" style="color:red; font-size:13px;"></span>
        </div>

        <button type="submit" class="btn-buy" style="padding:9px 20px;">Create</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}