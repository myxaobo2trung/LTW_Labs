@model IEnumerable<MaiDucDuy_241230684_DeOnTap.Models.TaiSan>
<div class="section-head">
    <h3>@ViewBag.SectionTitle</h3>
    <a asp-controller="Home" asp-action="Create">Thêm tài sản</a>
</div>
<div class="grid">
    @foreach (var item in Model)
    {
        <div class="asset-card">
            <a href="#"><img src="~/images/@item.Anh" alt="@item.TenTs" /></a>
            <h2>@item.TenTs</h2>
            <div class="asset-foot"><span class="price">@item.NguyenGia</span><button class="btn-buy">Chi tiết</button></div>
        </div>
    }
</div>

