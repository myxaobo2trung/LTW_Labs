@model IEnumerable<MaiDucDuy_241230684_DeThiMau.Models.HangHoa>
<div class="content_top">
    <div class="heading">
        <h3>@ViewBag.SectionTitle</h3>
    </div>
    <div class="see">
        <p><a asp-controller="Home" asp-action="Create">+ Thêm hàng hóa mới</a></p>
    </div>
    <div class="clear"></div>
</div>
<div class="section group">
    @foreach (var item in Model)
    {
        <div class="grid_1_of_4 images_1_of_4">
            <a href="#">
                <img src="~/images/@item.Anh" alt="@item.TenHang" />
            </a>
            <h2>@item.TenHang</h2>
            <div class="price-details">
                <div class="price-number">
                    <p><span class="rupees">@item.Gia</span></p>
                </div>
                <div class="add-cart">
                    <h4><a href="#">Add to Cart</a></h4>
                </div>
                <div class="clear"></div>
            </div>
        </div>
    }
</div>