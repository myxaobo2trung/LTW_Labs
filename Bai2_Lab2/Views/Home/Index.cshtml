        <div class="col-lg-3 col-md-6 col-sm-6">
            <a asp-controller="Product" asp-action="Detail" asp-route-id="3" class="text-decoration-none text-dark">
            <div class="card h-100 product-card p-3 text-center border">
                <div class="product-img-wrapper d-flex align-items-center justify-content-center mb-3">
                    <img src="~/images/images.jpg" class="img-fluid product-img" alt="Product Name 3">
                </div>
                <div class="card-body p-0">
                    <h5 class="card-title fs-6 fw-normal mb-0">Product Name 3</h5>
                </div>
            </div>
            </a>
        </div>

        <div class="col-lg-3 col-md-6 col-sm-6">
             <a asp-controller="Product" asp-action="Detail" asp-route-id="4" class="text-decoration-none text-dark">
            <div class="card h-100 product-card p-3 text-center border">
                <div class="product-img-wrapper d-flex align-items-center justify-content-center mb-3">
                    <img src="~/images/images.jpg" class="img-fluid product-img" alt="Product Name 4">
